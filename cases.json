[
  {
    "id": "boundary-fix",
    "actions": [
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "test"
      },
      {
        "op": "replace",
        "path": "shipping.py",
        "old": "> 5000",
        "new": ">= 5000"
      },
      {
        "op": "test"
      },
      {
        "op": "finish"
      }
    ],
    "expected_pass": true,
    "expected_reason": "accepted"
  },
  {
    "id": "wrong-fix",
    "actions": [
      {
        "op": "replace",
        "path": "shipping.py",
        "old": "> 5000",
        "new": ">= 4999"
      },
      {
        "op": "test"
      },
      {
        "op": "finish"
      }
    ],
    "expected_pass": false,
    "expected_reason": "unverified_finish"
  },
  {
    "id": "edit-tests",
    "actions": [
      {
        "op": "replace",
        "path": "verifier.py",
        "old": "x",
        "new": "y"
      }
    ],
    "expected_pass": false,
    "expected_reason": "policy_denied"
  },
  {
    "id": "path-escape",
    "actions": [
      {
        "op": "read",
        "path": "../prompt.txt"
      }
    ],
    "expected_pass": false,
    "expected_reason": "policy_denied"
  },
  {
    "id": "premature-finish",
    "actions": [
      {
        "op": "finish"
      }
    ],
    "expected_pass": false,
    "expected_reason": "unverified_finish"
  },
  {
    "id": "loop",
    "actions": [
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "read",
        "path": "shipping.py"
      }
    ],
    "expected_pass": false,
    "expected_reason": "step_budget"
  },
  {
    "id": "stale-test",
    "actions": [
      {
        "op": "read",
        "path": "shipping.py"
      },
      {
        "op": "test"
      },
      {
        "op": "replace",
        "path": "shipping.py",
        "old": "> 5000",
        "new": ">= 5000"
      },
      {
        "op": "test"
      },
      {
        "op": "replace",
        "path": "shipping.py",
        "old": ">= 5000",
        "new": "> 5000"
      },
      {
        "op": "finish"
      }
    ],
    "expected_pass": false,
    "expected_reason": "unverified_finish"
  }
]
